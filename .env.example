# Copy to .env (never commit .env). ONE model key is required for a live discovery run;
# replay never calls a model. Anthropic direct, or OpenRouter (OpenAI-compatible, any tool-calling model).
# Uncomment exactly one. The first key found selects the provider, so leaving a
# placeholder uncommented routes you to a provider you did not mean to use.
# ANTHROPIC_API_KEY=sk-ant-...
# OPENROUTER_API_KEY=sk-or-...
# GLOVEBOX_LLM_PROVIDER=openrouter        # anthropic | openrouter | openai (default: first key found)
# GLOVEBOX_MODEL=anthropic/claude-sonnet-5     # OpenRouter id (default). Also: anthropic/claude-opus-5, openai/gpt-5.6-sol, openai/gpt-5.6-luna, google/gemini-3.8-flash
# For Anthropic direct the default is claude-sonnet-5 (claude-opus-5 for the hardest flows).
# Credentials for the (fake) target app. Read at runtime, never written to artifacts or logs.
GLOVEBOX_APP_USERNAME=teller1
GLOVEBOX_APP_PASSWORD=teller1-pass
# Where runs, screenshots and traces are written
GLOVEBOX_RUNS_DIR=runs
